# ============================================
# CESAC AI - Variables de Entorno
# ============================================
# Copia este archivo como .env.local y completa los valores
# NUNCA subas .env.local al repositorio

# ============================================
# BASE DE DATOS
# ============================================
DATABASE_URL="postgresql://user:password@localhost:5432/cesac_ai?schema=public"

# Para pgvector (RAG):
# DATABASE_URL="postgresql://user:password@localhost:5432/cesac_ai?schema=public&pgvector=true"

# ============================================
# AUTENTICACIÓN (NextAuth)
# ============================================
AUTH_SECRET="your-super-secret-key-min-32-chars-change-this"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_URL_INTERNAL="http://localhost:3000"

# ============================================
# APLICACIÓN
# ============================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# ============================================
# STRIPE (Pagos)
# ============================================
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_your_stripe_publishable_key"
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret"

# Planes de suscripción (Stripe Price IDs)
STRIPE_PRICE_INDIVIDUAL="price_individual_monthly"
STRIPE_PRICE_PRO="price_pro_monthly"
STRIPE_PRICE_BUSINESS="price_business_monthly"
STRIPE_PRICE_GOVERNANCE="price_governance_monthly"

# ============================================
# INTELIGENCIA ARTIFICIAL
# ============================================
# Proveedor de IA (openai, anthropic, etc.)
AI_PROVIDER="openai"
AI_PROVIDER_API_KEY="sk-your-api-key-here"
AI_MODEL="gpt-4-turbo-preview"
AI_TEMPERATURE="0.7"
AI_MAX_TOKENS="2000"

# Para RAG con embeddings
AI_EMBEDDING_MODEL="text-embedding-3-small"
AI_EMBEDDING_DIMENSIONS="1536"

# ============================================
# ALMACENAMIENTO (Vercel Blob / S3)
# ============================================
BLOB_READ_WRITE_TOKEN="your_vercel_blob_token"
# O para S3:
# AWS_ACCESS_KEY_ID="your_aws_access_key"
# AWS_SECRET_ACCESS_KEY="your_aws_secret_key"
# AWS_REGION="eu-west-1"
# AWS_S3_BUCKET="cesac-ai-documents"

# ============================================
# EMAIL (SMTP / Resend)
# ============================================
EMAIL_SERVER_HOST="smtp.example.com"
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER="your_email_user"
EMAIL_SERVER_PASSWORD="your_email_password"
EMAIL_FROM="noreply@cesac.ai"

# O usando Resend:
# RESEND_API_KEY="re_your_resend_api_key"

# ============================================
# ANALYTICS (Opcional)
# ============================================
# NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"
# NEXT_PUBLIC_POSTHOG_KEY="your_posthog_key"

# ============================================
# SEGURIDAD
# ============================================
RATE_LIMIT_MAX_REQUESTS="100"
RATE_LIMIT_WINDOW_MS="60000"
CORS_ORIGINS="http://localhost:3000,https://cesac.ai"

# ============================================
# MONITORIZACIÓN (Opcional)
# ============================================
# SENTRY_DSN="https://your_sentry_dsn"
# LOG_LEVEL="info"

# ============================================
# DESARROLLO
# ============================================
# Deshabilitar telemetry de Next.js
NEXT_TELEMETRY_DISABLED="1"

# Habilitar logs de Prisma
# DEBUG="prisma:client,prisma:engine"
