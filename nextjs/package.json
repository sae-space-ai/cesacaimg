    "@types/bcryptjs": "^2.4.6",
    "typescript": "^5.7.0",
    "tailwindcss": "^4.1.7",
    "@tailwindcss/postcss": "^4.1.7",
    "eslint": "^8.0.0",
    "eslint-config-next": "^14.2.0",
