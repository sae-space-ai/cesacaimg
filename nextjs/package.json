    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "stripe": "^14.0.0",
    "zod": "^3.22.0",
    "lucide-react": "^0.294.0",
    "framer-motion": "^11.16.1",
    "recharts": "^2.10.0",
    "uuid": "^9.0.1",
    "date-fns": "^2.30.0",
