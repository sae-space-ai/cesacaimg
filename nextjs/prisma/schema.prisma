// Prisma Schema - CESAC AI
// Modelo de datos completo para PostgreSQL
// Generar con: npx prisma generate
// Migrar con: npx prisma migrate dev

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// USUARIOS Y AUTENTICACIÓN
// ============================================

enum UserRole {
  VISITOR
  STUDENT
  PROFESSIONAL
  COMPANY_USER
  COMPANY_ADMIN
  PUBLIC_EMPLOYEE
  PUBLIC_ORG_ADMIN
  TEACHER
  TUTOR
  CONSULTANT
  CONTENT_MANAGER
  SALES
  PROCUREMENT_MANAGER
  COMPLIANCE_OFFICER
  ADMIN
  SUPERADMIN
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  passwordHash  String
  role          UserRole  @default(STUDENT)
  avatar        String?
  organization  String?
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  // Relaciones
  account       Account?
  session       Session?
  enrollments   Enrollment[]
  certificates  Certificate[]
  orders        Order[]
  subscriptions Subscription[]
  aiConversations AIConversation[]
  auditEvents   AuditEvent[]
  consents      Consent[]
  notifications Notification[]
  crmInteractions CRMInteraction[]
  supportTickets SupportTicket[]

  @@index([email])
  @@index([role])
  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @unique
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================
// ORGANIZACIONES
// ============================================

enum OrganizationType {
  COMPANY
  EDUCATIONAL_CENTER
  PUBLIC_ADMINISTRATION
  OTHER
}

model Organization {
  id          String           @id @default(cuid())
  name        String
  type        OrganizationType
  taxId       String?          @unique
  address     String?
  phone       String?
  email       String?
  website     String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime?

  members     OrganizationMember[]
  orders      Order[]
  subscriptions Subscription[]

  @@map("organizations")
}

model OrganizationMember {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  role           String   @default("member")
  createdAt      DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@map("organization_members")
}

// ============================================
// CATÁLOGO DE PRODUCTOS
// ============================================

enum ProductStatus {
  DRAFT
  REVIEW
  PUBLISHED
  ARCHIVED
}

enum Modality {
  online
  presencial
  hibrido
  asincrono
}

model Product {
  id               String        @id @default(cuid())
  slug             String        @unique
  code             String        @unique
  name             String
  unitId           String
  shortDescription String        @db.Text
  description      String        @db.Text
  objectives       String[]
  targetAudience   String[]
  prerequisites    String[]
  modality         Modality
  duration         String
  hours            Int           @default(0)
  price            Int           @default(0)
  iva              Int           @default(21)
  priceCompany     Int           @default(0)
  pricePublic      Int           @default(0)
  image            String?
  program          String[]
  competencies     String[]
  learningOutcomes String[]
  certification    String
  startDate        String
  endDate          String
  places           Int           @default(0)
  status           ProductStatus @default(DRAFT)
  category         String
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  deletedAt        DateTime?

  versions         ProductVersion[]
  enrollments      Enrollment[]
  orderItems       OrderItem[]

  @@index([slug])
  @@index([unitId])
  @@index([status])
  @@map("products")
}

model ProductVersion {
  id        String   @id @default(cuid())
  productId String
  version   Int
  data      Json
  createdAt DateTime @default(now())

  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, version])
  @@map("product_versions")
}

// ============================================
// LMS - CURSOS Y APRENDIZAJE
// ============================================

model Course {
  id        String   @id @default(cuid())
  productId String   @unique
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  modules   CourseModule[]
  cohorts   Cohort[]

  @@map("courses")
}

model CourseModule {
  id        String   @id @default(cuid())
  courseId  String
  order     Int
  title     String
  content   String?  @db.Text
  createdAt DateTime @default(now())

  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons   Lesson[]

  @@map("course_modules")
}

model Lesson {
  id         String   @id @default(cuid())
  moduleId   String
  order      Int
  title      String
  type       String   @default("text")
  content    String?  @db.Text
  resourceUrl String?
  duration   Int?
  createdAt  DateTime @default(now())

  module     CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@map("lessons")
}

model Enrollment {
  id          String   @id @default(cuid())
  userId      String
  productId   String
  courseId    String?
  progress    Int      @default(0)
  status      String   @default("active")
  enrolledAt  DateTime @default(now())
  completedAt DateTime?

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("enrollments")
}

model Cohort {
  id        String   @id @default(cuid())
  courseId  String
  name      String
  startDate DateTime
  endDate   DateTime
  createdAt DateTime @default(now())

  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@map("cohorts")
}

model LearningProgress {
  id         String   @id @default(cuid())
  enrollmentId String
  lessonId   String
  completed  Boolean  @default(false)
  timeSpent  Int      @default(0)
  updatedAt  DateTime @updatedAt

  @@unique([enrollmentId, lessonId])
  @@map("learning_progress")
}

// ============================================
// EVALUACIÓN
// ============================================

model Assessment {
  id          String   @id @default(cuid())
  courseId    String
  title       String
  type        String
  passingScore Int     @default(70)
  timeLimit   Int?
  createdAt   DateTime @default(now())

  questions   Question[]
  attempts    ExamAttempt[]

  @@map("assessments")
}

model Question {
  id           String   @id @default(cuid())
  assessmentId String
  type         String
  text         String   @db.Text
  options      Json?
  correctAnswer String?
  points       Int      @default(1)
  order        Int
  createdAt    DateTime @default(now())

  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  answers      Answer[]

  @@map("questions")
}

model ExamAttempt {
  id           String   @id @default(cuid())
  assessmentId String
  userId       String
  startedAt    DateTime @default(now())
  completedAt  DateTime?
  score        Int?
  passed       Boolean?

  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  answers      Answer[]

  @@map("exam_attempts")
}

model Answer {
  id        String   @id @default(cuid())
  attemptId String
  questionId String
  answer    String   @db.Text
  isCorrect Boolean?
  points    Int      @default(0)

  attempt   ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question  Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("answers")
}

// ============================================
// CERTIFICADOS
// ============================================

model Certificate {
  id            String   @id @default(cuid())
  userId        String
  enrollmentId  String   @unique
  code          String   @unique
  issuedAt      DateTime @default(now())
  verificationUrl String
  hash          String

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([code])
  @@map("certificates")
}

// ============================================
// COMERCIO ELECTRÓNICO
// ============================================

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  COMPLETED
  CANCELLED
  REFUNDED
}

model Order {
  id             String      @id @default(cuid())
  userId         String
  organizationId String?
  status         OrderStatus @default(PENDING)
  subtotal       Int
  tax            Int
  total          Int
  currency       String      @default("EUR")
  paymentIntentId String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization? @relation(fields: [organizationId], references: [id])
  items          OrderItem[]
  payments       Payment[]

  @@index([userId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  productId String
  quantity  Int    @default(1)
  price     Int
  total     Int

  order     Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@map("order_items")
}

model Payment {
  id              String   @id @default(cuid())
  orderId         String
  amount          Int
  currency        String   @default("EUR")
  status          String
  method          String
  transactionId   String?  @unique
  createdAt       DateTime @default(now())

  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model Coupon {
  id          String   @id @default(cuid())
  code        String   @unique
  discount    Int
  type        String   @default("percentage")
  validFrom   DateTime
  validUntil  DateTime
  maxUses     Int?
  usedCount   Int      @default(0)
  createdAt   DateTime @default(now())

  @@map("coupons")
}

// ============================================
// SUSCRIPCIONES
// ============================================

model Subscription {
  id                 String   @id @default(cuid())
  userId             String
  organizationId     String?
  planId             String
  status             String   @default("active")
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean  @default(false)
  stripeSubscriptionId String? @unique
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization       Organization? @relation(fields: [organizationId], references: [id])

  @@map("subscriptions")
}

model SubscriptionPlan {
  id          String  @id @default(cuid())
  name        String  @unique
  price       Int
  period      String  @default("month")
  features    String[]
  stripePriceId String? @unique
  active      Boolean @default(true)

  @@map("subscription_plans")
}

// ============================================
// CRM
// ============================================

enum LeadStatus {
  LEAD
  CONTACTED
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

model Lead {
  id          String     @id @default(cuid())
  name        String
  email       String?
  phone       String?
  type        String
  status      LeadStatus @default(LEAD)
  value       Int?
  probability Int?
  assignedTo  String?
  notes       String?    @db.Text
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  interactions CRMInteraction[]

  @@index([status])
  @@map("leads")
}

model CRMInteraction {
  id        String   @id @default(cuid())
  leadId    String?
  userId    String?
  type      String
  subject   String?
  content   String?  @db.Text
  createdAt DateTime @default(now())

  lead      Lead?    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id])

  @@map("crm_interactions")
}

model SupportTicket {
  id        String   @id @default(cuid())
  userId    String
  subject   String
  content   String   @db.Text
  status    String   @default("open")
  priority  String   @default("medium")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("support_tickets")
}

// ============================================
// NOTIFICACIONES Y DOCUMENTOS
// ============================================

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String   @db.Text
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@map("notifications")
}

model Document {
  id          String   @id @default(cuid())
  name        String
  type        String
  url         String
  size        Int
  metadata    Json?
  version     Int      @default(1)
  uploadedBy  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  versions    DocumentVersion[]

  @@map("documents")
}

model DocumentVersion {
  id         String   @id @default(cuid())
  documentId String
  version    Int
  url        String
  createdAt  DateTime @default(now())

  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, version])
  @@map("document_versions")
}

// ============================================
// AI - TUTOR Y RAG
// ============================================

model AIKnowledgeSource {
  id          String   @id @default(cuid())
  documentId  String?
  title       String
  type        String
  content     String   @db.Text
  metadata    Json?
  embedding   Unsupported("vector")?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([type])
  @@map("ai_knowledge_sources")
}

model AIConversation {
  id        String   @id @default(cuid())
  userId    String
  agentId   String?
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  AIMessage[]

  @@map("ai_conversations")
}

model AIMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           String
  content        String   @db.Text
  sources        Json?
  confidence     Float?
  createdAt      DateTime @default(now())

  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("ai_messages")
}

model AIAgent {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  config      Json
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  executions  AgentExecution[]

  @@map("ai_agents")
}

model AgentExecution {
  id        String   @id @default(cuid())
  agentId   String
  userId    String?
  input     String   @db.Text
  output    String?  @db.Text
  sources   Json?
  status    String
  error     String?  @db.Text
  createdAt DateTime @default(now())

  agent     AIAgent  @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@map("agent_executions")
}

// ============================================
// GOVERNANCE
// ============================================

enum AIRiskLevel {
  MINIMAL
  LIMITED
  HIGH
  PROHIBITED
}

model AIInventoryItem {
  id              String      @id @default(cuid())
  organizationId  String?
  name            String
  purpose         String      @db.Text
  provider        String?
  model           String?
  riskLevel       AIRiskLevel @default(MINIMAL)
  humanOversight  Boolean     @default(true)
  documentation   Json?
  status          String      @default("active")
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([organizationId])
  @@map("ai_inventory_items")
}

model RiskAssessment {
  id             String   @id @default(cuid())
  inventoryItemId String
  assessor       String
  riskLevel      AIRiskLevel
  findings       Json
  mitigations    Json?
  approved       Boolean  @default(false)
  approvedBy     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("risk_assessments")
}

// ============================================
// PROCUREMENT
// ============================================

enum BidStatus {
  IDENTIFIED
  EVALUATING
  BID
  NO_BID
  SUBMITTED
  WON
  LOST
}

model ProcurementOpportunity {
  id                 String     @id @default(cuid())
  reference          String     @unique
  title              String
  contractingAuthority String
  cpv                String
  budget             Int?
  deadline           DateTime
  procedure          String?
  url                String?
  status             BidStatus  @default(IDENTIFIED)
  bidDecision        String?    @db.Text
  assignedTo         String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  bids               Bid[]

  @@index([status])
  @@index([deadline])
  @@map("procurement_opportunities")
}

model Bid {
  id              String    @id @default(cuid())
  opportunityId   String
  amount          Int?
  submittedAt     DateTime?
  status          BidStatus @default(IDENTIFIED)
  documents       Json?
  notes           String?   @db.Text
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  opportunity     ProcurementOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@map("bids")
}

// ============================================
// AUDITORÍA Y COMPLIANCE
// ============================================

model AuditEvent {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entity     String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  result     String   @default("success")
  createdAt  DateTime @default(now())

  actor      User?    @relation(fields: [actorId], references: [id])

  @@index([actorId])
  @@index([entity])
  @@index([createdAt])
  @@map("audit_events")
}

model Consent {
  id         String   @id @default(cuid())
  userId     String
  purpose    String
  version    String
  granted    Boolean  @default(true)
  grantedAt  DateTime @default(now())
  revokedAt  DateTime?

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("consents")
}

model PrivacyRequest {
  id        String   @id @default(cuid())
  userId    String
  type      String
  status    String   @default("pending")
  data      Json?
  processedAt DateTime?
  createdAt DateTime @default(now())

  @@map("privacy_requests")
}

// ============================================
// CONFIGURACIÓN DEL SISTEMA
// ============================================

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  category  String
  updatedAt DateTime @updatedAt

  @@index([category])
  @@map("system_settings")
}
